# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

export PATH="$HOME/.local/bin:$PATH"

eval "$(fnm env --use-on-cd)"

# pyenv
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init -)"

# Google Cloud SDK
_GCLOUD_PREFIX="$(brew --prefix)/share/google-cloud-sdk"
[[ -f "$_GCLOUD_PREFIX/path.zsh.inc" ]]       && source "$_GCLOUD_PREFIX/path.zsh.inc"
[[ -f "$_GCLOUD_PREFIX/completion.zsh.inc" ]] && source "$_GCLOUD_PREFIX/completion.zsh.inc"
unset _GCLOUD_PREFIX
