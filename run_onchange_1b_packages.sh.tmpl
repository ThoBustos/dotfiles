#!/bin/bash
# Homebrew packages — re-runs when Brewfile changes (macOS only)
# Brewfile hash: {{ include (joinPath .chezmoi.sourceDir "Brewfile") | sha256sum }}
[[ "$(uname)" != "Darwin" ]] && exit 0
set -euo pipefail

[[ -f /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"

BREWFILE="$HOME/.local/share/chezmoi/Brewfile"
echo "Installing packages from Brewfile..."
brew bundle install --file="$BREWFILE" || echo "Warning: some Brewfile packages failed — check above for details"
