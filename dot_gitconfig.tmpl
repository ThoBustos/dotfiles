[user]
	email = {{ .email | quote }}
	name = {{ .name | quote }}

[credential]
	helper = osxkeychain

[core]
	excludesfile = ~/.gitignore_global

[alias]
	lg = log --oneline --graph --decorate --all
	st = status -sb
	undo = reset --soft HEAD~1
	co = checkout
	br = branch

[pull]
	rebase = false

[init]
	defaultBranch = main
